# Contact form — Resend email delivery.
# Copy this file to .env.local for local development and fill in real values.
# In production these are set in the AWS Amplify Console (App settings →
# Environment variables), NOT in the repo. See README for details.

# Required. Resend API key (starts with "re_"). Server-only secret.
RESEND_API_KEY=

# Optional. Where contact messages are delivered.
# Defaults to the site email (info@softdevarts.com) if unset.
CONTACT_TO=

# Optional. The "From" address shown on delivered emails.
# Must be an address on a domain you have verified in Resend.
# Defaults to "SoftDevArts <onboarding@resend.dev>" (Resend's shared sender,
# which can only deliver to the Resend account owner — fine for testing).
CONTACT_FROM=
